import os, time, json, signal, numpy as np
from .exchanges import make_clients, load_universe
from .sizer import atr_size, kelly_adjust
from .pyramid import plan_pyramids
from .risk_guard import RiskGuard
from .metrics_ultra import start as metrics_start, set_equity, set_open, set_universe, error as m_err
def calc_atr(ohlcv, n=14):
    if len(ohlcv)<n+1: return None
    trs=[]
    for i in range(1,n+1):
        o,h,l,c,v=ohlcv[-i]; pc=ohlcv[-i-1][4]
        trs.append(max(h-l, abs(h-pc), abs(l-pc)))
    return float(np.mean(trs)) if trs else None
def load_equity():
    try:
        with open('equity.json','r') as f: return float(json.load(f).get('equity_usdt',1000))
    except Exception: return float(os.getenv('EQUITY_USDT','1000'))
def save_trade(rec):
    os.makedirs('runtime', exist_ok=True)
    with open('runtime/trades.jsonl','a') as f: f.write(json.dumps(rec)+'\n')
def main():
    metrics_start(int(os.getenv('ULTRA_METRICS_PORT','9113')))
    equity=load_equity(); set_equity(equity)
    rg=RiskGuard(daily_dd_limit=float(os.getenv('DAILY_DD_LIMIT','0.05')), max_positions=int(os.getenv('MAX_POSITIONS','12')))
    rg.start_day(equity)
    names=os.getenv('EXCHANGE','binance,okx').split(','); clients=make_clients(names)
    universe=load_universe(clients, quote=os.getenv('QUOTE','USDT'), top_n=int(os.getenv('TOP_N','120')), min_vol_usd=int(os.getenv('MIN_VOL_USD','200000')))
    set_universe(len(universe))
    open_pos={}; winrate=0.5; rr=1.2
    base_risk=float(os.getenv('RISK_FRAC','0.005')); scan_limit=int(os.getenv('SCAN_LIMIT','60'))
    trail=float(os.getenv('TRAIL_PCT','0.03')); take_min=float(os.getenv('TAKE_MIN','0.02'))
    print(f"[ultra] equity={equity:.2f} pairs={len(universe)}")
    stop=False
    def _s(*_): 
        nonlocal stop; stop=True
    signal.signal(signal.SIGINT,_s); signal.signal(signal.SIGTERM,_s)
    while not stop:
        try:
            set_open(len(open_pos))
            if int(time.time())%3600<5:
                universe=load_universe(clients, quote=os.getenv('QUOTE','USDT'), top_n=int(os.getenv('TOP_N','120')), min_vol_usd=int(os.getenv('MIN_VOL_USD','200000')))
                set_universe(len(universe))
            for ex,sym in universe[:scan_limit]:
                c=clients[ex]
                try:
                    ohl=c.fetch_ohlcv(sym,timeframe='5m',limit=80)
                    closes=[x[4] for x in ohl]; price=float(closes[-1])
                    sma20=float(np.mean(closes[-20:])); mom=(price/closes[-7]-1.0) if closes[-7]>0 else 0.0
                    if (ex,sym) not in open_pos:
                        if price>sma20 and mom>0.01:
                            atr=calc_atr(ohl) or price*0.01
                            frac=kelly_adjust(winrate, rr, base_frac=1.0)*base_risk
                            qty=atr_size(equity, price, atr, risk_frac=frac, max_leverage=float(os.getenv('MAX_LEV','1.0')))
                            if qty>0:
                                ok,_=rg.check(equity, len(open_pos)); 
                                if not ok: continue
                                try: c.create_order(sym,'market','buy',qty)
                                except Exception: continue
                                targets=plan_pyramids(price, atr, steps=int(os.getenv('PYRAMID_STEPS','3')), step_mult=float(os.getenv('PYRAMID_ATR_MULT','1.0')))
                                open_pos[(ex,sym)]={'qty':qty,'entry':price,'targets':targets,'peak':price}
                                save_trade({'t':time.time(),'ex':ex,'sym':sym,'side':'buy','qty':qty,'price':price,'type':'entry'})
                    else:
                        pos=open_pos[(ex,sym)]; pos['peak']=max(pos['peak'], price)
                        if pos['targets'] and price>=pos['targets'][0]:
                            add_qty=pos['qty']*float(os.getenv('PYRAMID_ADD_FRAC','0.5'))
                            try: c.create_order(sym,'market','buy',add_qty); pos['qty']+=add_qty; pos['targets']=pos['targets'][1:]; save_trade({'t':time.time(),'ex':ex,'sym':sym,'side':'buy','qty':add_qty,'price':price,'type':'pyramid'})
                            except Exception: pass
                        entry=pos['entry']; peak=pos['peak']
                        if entry>0 and (peak-entry)/entry>=take_min:
                            stop_price=peak*(1.0-trail)
                            if price<=stop_price:
                                qty=pos['qty']
                                try: c.create_order(sym,'market','sell',qty)
                                except Exception: pass
                                pnl=(price-entry)/entry
                                winrate=0.9*winrate+0.1*(1.0 if pnl>0 else 0.0)
                                rr=0.9*rr+0.1*max(0.5, abs(pnl)*10)
                                save_trade({'t':time.time(),'ex':ex,'sym':sym,'side':'sell','qty':qty,'price':price,'type':'exit','pnl':pnl})
                                del open_pos[(ex,sym)]
                except Exception:
                    m_err(); continue
            set_equity(equity); time.sleep(float(os.getenv('LOOP_DELAY','5')))
        except Exception:
            m_err(); time.sleep(1)
if __name__=='__main__': main()
